        uniform double[] edge:range = [0, 20, 0, 20, 0, 20, 0, 20, 0, 20, 0, 10, 0, 10, 0, 20, 0, 10, 0, 20, 0, 10, 0, 20, 0, 1, 0, 1, 5, 15]
