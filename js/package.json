{
  "name": "smlibjs",
  "version": "0.0.0",
  "private": true,
  "description": "CAD in JavaScript on the SMLib NURBS kernel, compiled to WebAssembly: smlibpy's API for the web and Node",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "wasm"
  ],
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3"
  }
}
